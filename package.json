{
  "name": "@scripteurist/streamlike-client",
  "version": "0.3.0",
  "description": "Player Streamlike côté navigateur : URL d'embed, pilotage postMessage, dépôt direct (mode dégradé). Agnostique du framework, sans dépendance.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepare": "npm run build"
  },
  "keywords": [
    "streamlike",
    "player",
    "embed",
    "video",
    "browser"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "jsdom": "^25.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillaume-scripteurist/streamlike-client.git"
  }
}
